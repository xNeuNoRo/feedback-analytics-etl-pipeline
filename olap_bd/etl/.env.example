# Configuración de la Base de Datos Transaccional (OLTP)
OLTP_DB_HOST=localhost
OLTP_DB_PORT=5433
OLTP_DB_NAME=oltp_dev
OLTP_DB_USER=postgres
OLTP_DB_PASSWORD=postgres

# Configuración de la Base de Datos Analítica (OLAP Data Warehouse)
OLAP_DB_HOST=localhost
OLAP_DB_PORT=5434
OLAP_DB_NAME=olap_dev
OLAP_DB_USER=postgres
OLAP_DB_PASSWORD=postgres

# Configuración de Extracción desde la API REST de Redes Sociales
API_BASE_URL=http://localhost:8000
API_KEY=oltp-secret-api-key-bigdata-project-2026

# Ruta de los Archivos CSV de Encuestas
CSV_FOLDER_PATH=./data/input

# Configuración del Pipeline ETL
LOG_LEVEL=INFO
BATCH_SIZE=1000

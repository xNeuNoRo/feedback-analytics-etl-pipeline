# Configuración de la Base de Datos (OLTP - PostgreSQL)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=oltp_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_MIN_POOL_SIZE=2
DB_MAX_POOL_SIZE=10

# Configuración del Servidor de la API
API_ENV=development
API_PORT=8000
LOG_LEVEL=INFO

# Seguridad de la API (Clave Secreta para la cabecera X-API-Key)
API_KEY=oltp-secret-api-key-bigdata-project-2026